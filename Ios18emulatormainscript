   if p.dead or vi.seen[p]~=fr then lab.Visible=false vi.pl[p]=nil vi.pool[#vi.pool+1]=lab end end
 end end
-- ---------- pack discovery ----------
local function rank(n) n=n:lower()
 if n:find("background") then return 1 elseif n:find("floating") then return 2 elseif n:find("foreground") then return 3 end return 2 end
local function isCA(p)
 if p:lower():match("%.ca$") then return true end
 local ok,r=pcall(isfile,p.."/main.caml") return ok and r and true or false end
local function walk(dir,depth,out)
 if depth>40 then return end
 local ok,list=pcall(listfiles,dir) if not ok then return end
 for _,p in ipairs(list) do
  if p:find("__MACOSX",1,true) then
  elseif isfolder(p) then
   if isCA(p) then out[#out+1]=p else walk(p,depth+1,out) end
  elseif p:lower():match("%.tendies$") then
   warn("[iOS18] Found "..p..": .tendies files are read directly when placed in "..ROOT.."/wallpapers/") end
 end end
local function addPack(top,name)
 local cas={} walk(top,0,cas)
 if #cas==0 then warn("[iOS18] '"..name.."': no .ca layer folders (main.caml) found inside it.") return end
 local groups,order={},{}
 for _,c in ipairs(cas) do
  local parent=c:match("^(.*)[/\\][^/\\]+$") or c
  local desc=parent:match("^(.*[/\\]descriptors[/\\][^/\\]+)") or "main"
  local g=groups[desc] if not g then g={parents={},order={}} groups[desc]=g order[#order+1]=desc end
  local pl=g.parents[parent] if not pl then pl={} g.parents[parent]=pl g.order[#g.order+1]=parent end
  pl[#pl+1]=c end
 for di,desc in ipairs(order) do
  local g=groups[desc]
  local parent,bs=nil,-1e9
  for _,par in ipairs(g.order) do
   local l=par:lower() local s=#g.parents[par]
   if l:find("contents",1,true) then s=s+100 end
   if l:find("supplements",1,true) then s=s-100 end
   if s>bs then parent,bs=par,s end end
  local mine=g.parents[parent]
  table.sort(mine,function(a2,b2) return rank(a2)<rank(b2) end)
  local list={}
  for _,c in ipairs(mine) do
   local ok,ca=pcall(TE.parseCA,c)
   if ok and ca then ca.dir=c list[#list+1]=ca elseif not ok then warn("[iOS18] "..c..": "..tostring(ca)) end end
  if #list==0 then warn("[iOS18] No readable layers in "..name) else
   local dw,dh=(parent or ""):match("(%d+)w%-(%d+)h")
   dw=tonumber(dw) or W dh=tonumber(dh) or H
   local pname=(#order>1) and (name.." "..di) or name
   local id=pname:gsub("%W","_")
   TE.packs[#TE.packs+1]={id=id,name=pname,cas=list,dw=dw,dh=dh}
   table.insert(X.CAT,{id="lw_"..id,name="Live: "..pname,author="Tendies",ver="2.0.0",sec="Animations",col=TEAL,
    desc="Animated wallpaper from a .tendies file.",long="Animated wallpaper with Lock, Home and Sleep states, Light/Dark variants, state transitions, keyframe animations and particle emitters."})
   local sn={} for k in pairs(list[1].states) do sn[#sn+1]=k end table.sort(sn)
   local rb=list[1].root.base
   print("[iOS18] Loaded live wallpaper '"..pname.."' ("..#list.." layer sets, root "..rb.w.."x"..rb.h..", states: "..(#sn>0 and table.concat(sn,", ") or "none")..")") end
 end end

X.unzipTendies=function(p,dest)
 local data=readfile(p)
 local mark=dest.."/_ok2.txt"
 local okm,ex=pcall(isfile,mark)
 if okm and ex then local okr,v=pcall(readfile,mark) if okr and v==tostring(#data) then return true end end
 FP.mkdirs(dest)
 local n=0
 FP.unzip(data,function(name,bytes)
  if name:find("__MACOSX",1,true) or name:find("%.DS_Store$") or name:match("[^/]*$"):sub(1,2)=="._" then return end
  local rp=FP.san(name:gsub("\\","/"))
  if ("/"..rp.."/"):find("/%.%./") then return end
  local full=dest.."/"..rp
  local dir=full:match("^(.*)/[^/]+$") if dir then FP.mkdirs(dir) end
  writefile(full,bytes) n=n+1 end)
 if n==0 then error("the file has no content") end
 pcall(writefile,mark,tostring(#data))
 return true end
if FS and GA then
 FP.mkdirs(ROOT.."/tendies_cache")
 for _,p in ipairs(listfiles(ROOT.."/wallpapers")) do
  if isfolder(p) then addPack(p,p:match("([^/\\]+)$"))
  elseif p:lower():match("%.tendies$") or p:lower():match("%.zip$") then
   local nm=((p:match("([^/\\]+)$") or "tendies"):gsub("%.[%a]+$",""))
   local dest=ROOT.."/tendies_cache/"..FP.san(nm)
   local ok,err=pcall(X.unzipTendies,p,dest)
   if ok then addPack(dest,nm) else warn("[iOS18] Could not open "..p..": "..tostring(err)) end end end
elseif FS then warn("[iOS18] This executor has no getcustomasset: live wallpapers are disabled.") end
do local u={} for k in pairs(TE.UNK) do u[#u+1]=k end table.sort(u)
