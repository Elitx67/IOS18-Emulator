tw(b,.08,{BackgroundColor3=isOp and C3(255,200,120) or (isFn and C3(215,215,215) or C3(115,115,115))}) end end)
b.MouseButton1Click:Connect(function() press(k) if not (isOp and st.op and st.fresh) then tw(b,.3,{BackgroundColor3=bg}) end end)
col=col+((k=="0") and 2 or 1) end end
