  local fm=(T.from==from) and 2 or ((T.from=="*") and 1 or nil)
  local tm=(T.to==to) and 2 or ((T.to=="*") and 1 or nil)
  if fm and tm and fm*10+tm>bs then best,bs=T,fm*10+tm end end
 return best end
