local LINES={{1,2,3},{4,5,6},{7,8,9},{1,4,7},{2,5,8},{3,6,9},{1,5,9},{3,5,7}}
local function winner(b) for _,l in ipairs(LINES) do local a=b[l[1]] if a~="" and a==b[l[2]] and a==b[l[3]] then return a,l end end end
local function minimax(b,turn,depth)
local w=winner(b)
if w=="O" then return 10-depth elseif w=="X" then return depth-10 end
local full=true for i=1,9 do if b[i]=="" then full=false end end
if full then return 0 end
