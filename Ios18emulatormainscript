  local T={from=tr.a.fromState or "*",to=tr.a.toState or "*",by={}}
  local el=kid(tr,"elements")
  if el then for _,e in ipairs(el.kids) do if e.tag=="LKStateTransitionElement" and e.a.targetId then
   local an=kid(e,"animation")
