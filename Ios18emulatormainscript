return string.format("%.9g",n) end
local function fmt(s)
if s=="Error" then return s end
local neg,int,frac=s:match("^(-?)(%d+)(%.?%d*)$") if not int then return s end
local r=int:reverse():gsub("(%d%d%d)","%1,"):reverse()
r=r:gsub("^,","") return neg..r..frac end
