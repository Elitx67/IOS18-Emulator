local function push(title,build,instant)
local prev=stack[#stack]
local p,sf=mkPage(title,prev and prev.title or nil)
build(sf) stack[#stack+1]={p=p,sf=sf,title=title,build=build}
if instant then p.Position=UDim2.fromOffset(0,0) if prev then prev.p.Position=UDim2.fromOffset(-W*.3,0) end return end
p.Position=UDim2.fromOffset(W,0) tw(p,.5,{Position=UDim2.fromOffset(0,0)})
if prev then tw(prev.p,.5,{Position=UDim2.fromOffset(-W*.3,0)}) end end
pop=function()
if #stack<2 then return end
local c=table.remove(stack) local prev=stack[#stack]
X.kbClose()
tw(c.p,.48,{Position=UDim2.fromOffset(W,0)}) tw(prev.p,.48,{Position=UDim2.fromOffset(0,0)})
task.delay(.12,function() if prev.sf.Parent then local cp=prev.sf.CanvasPosition prev.sf:ClearAllChildren() prev.build(prev.sf) prev.sf.CanvasPosition=cp end end)
task.delay(.55,function() c.p:Destroy() end) end
