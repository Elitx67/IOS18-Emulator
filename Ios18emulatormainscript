-- route the classic text messages to the rich layouts
local oldIsland=X.island
X.island=function(msg,dur,glyph)
 if type(msg)=="string" then
  local pc=msg:match("^Charging%s+(%d+)%%") if pc then return X.islandAct("charging",{pct=tonumber(pc)}) end
  if msg:find("^AirPods") then return X.islandAct("airpods",{name=(msg:gsub("%s*Connected$",""))}) end
  if msg=="Silent Mode On" then return X.islandAct("silent",{on=true}) end
  if msg=="Silent Mode Off" then return X.islandAct("silent",{on=false}) end
  if S.focus and S.focusName and msg==S.focusName then return X.islandAct("focus",{on=true,name=msg}) end
  if msg=="Focus Off" then return X.islandAct("focus",{on=false,name="Focus"}) end
  if msg=="Screen Recording" then X.recT0=X.recT0 or os.clock() return X.islandAct("rec",{},2.2) end
  local who=msg:match("^Calling (.+)…$") if who then X.callOn={name=who,t0=os.clock()} return X.islandAct("callon",{name=who},0) end
  if msg=="Video saved" or msg=="Photo saved" or msg=="Screenshot Saved" then return X.islandAct("saved",{text=(msg:gsub(" [Ss]aved"," saved"))}) end
 end
 X.curKind=nil
 return oldIsland(msg,dur,glyph) end
local oldRest=X.islRest
X.islRest=function() X.curKind=nil oldRest() end
-- watchers: timer finish, alarms, low battery, live activities
do local acc,lastMin=0,-1
 conn(RunService.Heartbeat,function(dt)
  acc=acc+dt if acc<1 then return end acc=0
  if S.tm and S.tm.run and os.clock()>=S.tm.endAt then S.tm.run=false S.tm.left=0 X.islandAct("timerdone",{}) end
  if S.rec then X.recT0=X.recT0 or os.clock() else X.recT0=nil end
  local t=os.date("*t") local key=t.hour*60+t.min
  if key~=lastMin then lastMin=key
   for _,a in ipairs(S.alarms or {}) do if a.on and a.h==t.hour and a.m==t.min then
    local h12=a.h%12 if h12==0 then h12=12 end
    X.islandAct("alarm",{label=a.label,time=string.format("%d:%02d %s",h12,a.m,a.h<12 and "AM" or "PM")}) break end end end
  if S.batt and S.batt<=20 and not S.charging then if not X.lowFired then X.lowFired=true X.islandAct("lowbat",{pct=S.batt}) end
  else X.lowFired=false end
  if not X.curKind and X.liveKind() then X.liveRest() end
 end) end

