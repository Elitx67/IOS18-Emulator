TE.pickState=function(ca,base,mode)
 local want=mode:lower() local other=(want=="dark") and "light" or "dark"
 local best,bestScore=nil,-1
 for name,s in pairs(ca.states) do
  local l=name:lower()
  local ok
  if base=="lock" then ok=l:find("lock") and not l:find("unlock")
  elseif base=="home" then ok=l:find("unlock") or l:find("home")
  else ok=l:find("sleep") or l:find("aod") or l:find("%f[%a]off%f[%A]") end
  if ok and not l:find(other) and not l:find("landscape") then
   local sc=10
   if l:find(want) then sc=sc+4 end
   if l:find("portrait") then sc=sc+1 end
   sc=sc-#l*.001
   if sc>bestScore then best,bestScore=s,sc end end end
 if best then return TE.flatten(ca.states,best,0),best.name end
 return nil end
TE.findTr=function(ca,from,to)
