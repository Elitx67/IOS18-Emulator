local function numToStr(n) if n~=n or math.abs(n)==math.huge then return "Error" end
if n==math.floor(n) and math.abs(n)<1e15 then return string.format("%d",n) end
return string.format("%.9g",n) end
local function fmt(s)
if s=="Error" then return s end
local neg,int,frac=s:match("^(-?)(%d+)(%.?%d*)$") if not int then return s end
local r=int:reverse():gsub("(%d%d%d)","%1,"):reverse()
r=r:gsub("^,","") return neg..r..frac end
local function cur() return tonumber(st.disp) or 0 end
local function ev(a,op,b) if op=="+" then return a+b elseif op=="-" then return a-b elseif op=="*" then return a*b end
if b==0 then return math.huge end return a/b end
local btns={}
local SYM={["÷"]="/",["×"]="*",["-"]="-",["+"]="+"}
local function refresh()
lbl.Text=fmt(st.disp) btns["AC"].Text=(st.fresh and st.disp=="0") and "AC" or "C"
for k,sym in pairs(SYM) do local on=(st.op==sym and st.fresh)
btns[k].BackgroundColor3=on and WHITE or ORANGE btns[k].TextColor3=on and ORANGE or WHITE end end
local function press(k)
if st.disp=="Error" and k~="AC" then return end
if k:match("^%d$") then
if st.fresh then st.disp=k st.fresh=false elseif st.disp=="0" then st.disp=k
elseif #(st.disp:gsub("[-.]",""))<9 then st.disp=st.disp..k end
elseif k=="." then if st.fresh then st.disp="0." st.fresh=false
elseif not st.disp:find(".",1,true) then st.disp=st.disp.."." end
elseif k=="AC" then if btns["AC"].Text=="C" then st.disp="0" st.fresh=true
else st.disp="0" st.fresh=true st.acc=nil st.op=nil end
elseif k=="±" then if st.disp~="0" then
if st.disp:sub(1,1)=="-" then st.disp=st.disp:sub(2) else st.disp="-"..st.disp end end
elseif k=="%" then st.disp=numToStr(cur()/100)
elseif k=="=" then if st.op then st.disp=numToStr(ev(st.acc,st.op,cur())) st.acc=nil st.op=nil st.fresh=true end
else
local sym=SYM[k]
if st.op and not st.fresh then st.acc=ev(st.acc,st.op,cur()) st.disp=numToStr(st.acc) else st.acc=cur() end
st.op=sym st.fresh=true end
refresh() end
