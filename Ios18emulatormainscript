local function i3(c) return Color3.new(1-c.R,1-c.G,1-c.B) end
local function inv3(v)
if typeof(v)=="Color3" then return i3(v)
elseif typeof(v)=="ColorSequence" then
local k={} for i,kp in ipairs(v.Keypoints) do k[i]=ColorSequenceKeypoint.new(kp.Time,i3(kp.Value)) end
return ColorSequence.new(k) end
return v end
local function near(a,b) return abs(a.R-b.R)<.006 and abs(a.G-b.G)<.006 and abs(a.B-b.B)<.006 end
local function same(a,b)
if typeof(a)=="ColorSequence" and typeof(b)=="ColorSequence" then
local ka,kb=a.Keypoints,b.Keypoints
if #ka~=#kb then return false end
for i=1,#ka do if not near(ka[i].Value,kb[i].Value) then return false end end
return true end
if typeof(a)=="Color3" and typeof(b)=="Color3" then return near(a,b) end
return a==b end
