for i=1,9 do if b[i]=="" then
b[i]=turn
local v=minimax(b,(turn=="O") and "X" or "O",depth+1)
b[i]=""
if turn=="O" then best=math.max(best,v) else best=math.min(best,v) end end end
return best end
