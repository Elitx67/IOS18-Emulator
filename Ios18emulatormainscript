local function collect(n,tag,out)
 for _,k in ipairs(n.kids) do if k.tag==tag then out[#out+1]=k else collect(k,tag,out) end end return out end
TE.valEl=function(e) return kid(e,"value") end
TE.parseCA=function(dir)
 FP.dir=dir
 local ok,s=pcall(readfile,dir.."/main.caml") if not ok or type(s)~="string" then return nil end
 local doc=TE.xml(s) local caml=doc.kids[1] if not caml then return nil end
 local top
 for _,k in ipairs(caml.kids) do if LAYER[k.tag] then top=k break end end
 if not top then return nil end
 local reg={} local root=TE.mkLayer(top,dir,reg,nil)
 local states={}
 for _,sn in ipairs(collect(caml,"states",{})) do for _,st in ipairs(sn.kids) do if st.tag=="LKState" and st.a.name then
  local S_=states[st.a.name]
  if not S_ then S_={name=st.a.name,based=st.a.basedOn,vals={},anims={},img={},subs={},cell={}} states[st.a.name]=S_ end
  local el=kid(st,"elements")
  if el then for _,e in ipairs(el.kids) do
   local tid,kp=e.a.targetId,e.a.keyPath
   if e.tag=="LKStateSetValue" and tid and kp then
    local v=kid(e,"value")
    local m=TE.KP[kp]
    if kp=="contents" then
     local src=v and TE.imgSrc(v)
     if src then S_.img[tid]=FP.rel(src) if reg[tid] then reg[tid].needImg=true end elseif not v or not next(v.a) then S_.img[tid]=false end
    elseif kp=="sublayers" then
     if v then local ids={} for _,x in ipairs(v.kids) do if x.a.object then ids[#ids+1]=x.a.object end end S_.subs[tid]=ids end
    elseif kp:find("^emitterCells%.") then
     local nm,pr=kp:match("^emitterCells%.(.-)%.([^%.]+)$")
     if nm and v then
      S_.cell[tid]=S_.cell[tid] or {}
      if pr=="contents" then local src=TE.imgSrc(v) S_.cell[tid][nm.."."..pr]=src and FP.rel(src) or false
      else local n=tonumber(v.a.value) if n then S_.cell[tid][nm.."."..pr]=n end end end
    elseif EMK[kp] and v then S_.cell[tid]=S_.cell[tid] or {} S_.cell[tid][".."..kp]=tonumber(v.a.value)
    elseif m and v then
     local c=TE.pval(m,v)
     if c then S_.vals[tid]=S_.vals[tid] or {} for i,key in ipairs(m.k) do S_.vals[tid][key]=c[i] end end
    elseif not TE.IGN[kp] and not m then TE.UNK[kp.." (state value)"]=true end
   elseif e.tag=="LKStateAddAnimation" and tid then
    local an=kid(e,"animation")
    if an then
     local A=TE.parseAnim(an,tid)
     if A then A.key=e.a.key S_.anims[tid]=S_.anims[tid] or {}
      local l=S_.anims[tid]
      if A.key then for i=#l,1,-1 do if l[i].key==A.key then table.remove(l,i) end end end
      l[#l+1]=A end end
   end end end
 end end end
 local trans={}
 for _,tn in ipairs(collect(caml,"stateTransitions",{})) do for _,tr in ipairs(tn.kids) do if tr.tag=="LKStateTransition" then
  local T={from=tr.a.fromState or "*",to=tr.a.toState or "*",by={}}
  local el=kid(tr,"elements")
  if el then for _,e in ipairs(el.kids) do if e.tag=="LKStateTransitionElement" and e.a.targetId then
   local an=kid(e,"animation")
   local key=e.a.key or e.a.keyPath or (an and an.a.keyPath)
   local m=key and TE.KP[key]
   if m then
    local sp=TE.trSpec(an,e)
    T.by[e.a.targetId]=T.by[e.a.targetId] or {}
    for _,ch in ipairs(m.k) do T.by[e.a.targetId][ch]=sp or {off=true} end
   end end end end
  trans[#trans+1]=T end end end
 return {root=root,reg=reg,states=states,trans=trans,res={}} end

-- merged copy of a state following basedOn
TE.flatten=function(states,S_,depth)
 if not S_ or not S_.based or depth>6 or not states[S_.based] then return S_ end
 local base=TE.flatten(states,states[S_.based],depth+1)
 local M={name=S_.name,vals={},anims={},img={},subs={},cell={}}
 for _,src in ipairs({base,S_}) do
  for tid,v in pairs(src.vals) do M.vals[tid]=M.vals[tid] or {} for k,x in pairs(v) do M.vals[tid][k]=x end end
  for tid,l in pairs(src.anims) do M.anims[tid]=l end
  for tid,x in pairs(src.img) do M.img[tid]=x end
  for tid,x in pairs(src.subs) do M.subs[tid]=x end
  for tid,v in pairs(src.cell) do M.cell[tid]=M.cell[tid] or {} for k,x in pairs(v) do M.cell[tid][k]=x end end
 end
 return M end

-- Lock / Home(Unlock) / Sleep state for the current appearance (Light/Dark); tolerant with names
TE.pickState=function(ca,base,mode)
 local want=mode:lower() local other=(want=="dark") and "light" or "dark"
 local best,bestScore=nil,-1
 for name,s in pairs(ca.states) do
  local l=name:lower()
  local ok
  if base=="lock" then ok=l:find("lock") and not l:find("unlock")
  elseif base=="home" then ok=l:find("unlock") or l:find("home")
  else ok=l:find("sleep") or l:find("aod") or l:find("%f[%a]off%f[%A]") end
  if ok and not l:find(other) and not l:find("landscape") then
   local sc=10
   if l:find(want) then sc=sc+4 end
   if l:find("portrait") then sc=sc+1 end
   sc=sc-#l*.001
   if sc>bestScore then best,bestScore=s,sc end end end
 if best then return TE.flatten(ca.states,best,0),best.name end
 return nil end
TE.findTr=function(ca,from,to)
 local best,bs=nil,-1
 for _,T in ipairs(ca.trans) do
  local fm=(T.from==from) and 2 or ((T.from=="*") and 1 or nil)
  local tm=(T.to==to) and 2 or ((T.to=="*") and 1 or nil)
  if fm and tm and fm*10+tm>bs then best,bs=T,fm*10+tm end end
 return best end
-- ---------- simulation (shared by the lock / home / aod views) ----------
TE.CFG={implicit=.25,maxParticles=420,perEmitter=140,warmCap=8}
local EMPTY={vals={},anims={},img={},subs={},cell={}}
local floor,sqrt,cos,sin,abs,max,min=math.floor,math.sqrt,math.cos,math.sin,math.abs,math.max,math.min
local function copy(t) local o={} for k,v in pairs(t) do o[k]=v end return o end
-- tiny deterministic RNG
local function rng(seed)
 local s=(seed*2654435761+12345)%4294967296
 return function() s=(s*1664525+1013904223)%4294967296 return s/4294967296 end end

TE.build=function(pack,ca,fitW,fitH)
 local inst={ca=ca,nodes={},byId={},ems={},now=0,t0=0,stateName=nil,stateObj=EMPTY,tracks=0,live=0}
 local z=0
 local function mk(L,parent)
  local n={L=L,parent=parent,v=copy(L.base),cv=copy(L.base),tg=copy(L.base),dyn={},trk={},kidsCur={},baseKids={},sc=1}
  z=z+1 n.z=z
  n.clk=(parent and parent.clk0 or 0)-L.bt+L.to n.clk0=n.clk
  inst.nodes[#inst.nodes+1]=n inst.byId[L.id]=n
  local ks={} for i,c in ipairs(L.kids) do ks[i]={c,i} end
  table.sort(ks,function(p1,p2) if p1[1].zp~=p2[1].zp then return p1[1].zp<p2[1].zp end return p1[2]<p2[2] end)
  for _,e in ipairs(ks) do local c=mk(e[1],n) n.baseKids[#n.baseKids+1]=c n.kidsCur[#n.kidsCur+1]=c end
  return n end
 inst.root=mk(ca.root,nil)
 -- dynamic channels
 local function dynmark(tid,k) local n=inst.byId[tid] if n then n.dynset=n.dynset or {} n.dynset[k]=true end end
 for _,n in ipairs(inst.nodes) do
  if n.L.anims then for _,A in ipairs(n.L.anims) do for _,k in ipairs(A.keys) do dynmark(n.L.id,k) end end end
  if n.L.needImg then n.needImg=true end end
 for _,S_ in pairs(ca.states) do
  for tid,vs in pairs(S_.vals) do for k in pairs(vs) do dynmark(tid,k) end end
  for tid,l in pairs(S_.anims) do for _,A in ipairs(l) do for _,k in ipairs(A.keys) do dynmark(tid,k) end end end
  for tid in pairs(S_.img) do local n=inst.byId[tid] if n then n.needImg=true end end
 end
 for _,n in ipairs(inst.nodes) do
  n.dynl={} if n.dynset then for k in pairs(n.dynset) do n.dynl[#n.dynl+1]=k end end
  local B=n.L.base
  n.hasBg=(B.bgA>.003) or (n.dynset and (n.dynset.bgA or n.dynset.bgR) and true) or false
  if n.L.em then
   n.em={pl={},acc={},rnd=rng((n.L.em.seed or 0)+#inst.nodes*7+n.z),cellOv=nil,t=0}
   inst.ems[#inst.ems+1]=n end
 end
 -- fit: aspect-fill the layer's own size onto the screen
 local rb=ca.root.base local dw,dh=rb.w,rb.h
 if dw<=0 or dh<=0 then dw,dh=pack.dw,pack.dh end
 inst.rw,inst.rh=dw,dh
 inst.fit=max(fitW/dw,fitH/dh)
 inst.fw,inst.fh=fitW,fitH
 inst.zmax=z
 return inst end

local function trackVal(tk,now)
 local el=(now-tk.t0)
 if el<0 then return tk.from,false end
 local s=tk.spec
 local p
 if s.spring then
  local tt=el*s.spd
  if tt>=s.dur then return tk.to,true end
  p=s.spring(tt)
 else
  local pp=el*s.spd/s.dur
  if pp>=1 then return tk.to,true end
  p=s.tf(pp) end
 return tk.from+(tk.to-tk.from)*p,false end

local DISC={hid=1}
TE.enter=function(inst,sobj,sname,now,first)
 local ca=inst.ca
 sobj=sobj or EMPTY
 local prevName=inst.stateName
 inst.stateObj=sobj inst.stateName=sname inst.t0=now
 local T=(not first) and TE.findTr(ca,prevName or "*",sname or "*") or nil
 -- sublayer membership
 local reparent,explicit={},{}
 for tid,ids in pairs(sobj.subs) do
  local pn=inst.byId[tid]
  if pn then explicit[tid]=true for _,id in ipairs(ids) do local cn=inst.byId[id] if cn and cn~=pn then reparent[cn]=pn end end end end
 for _,n in ipairs(inst.nodes) do n.kidsCur={} end
 for _,n in ipairs(inst.nodes) do
  local p=reparent[n] or n.parent
  if p then
   if reparent[n] or not explicit[p.L.id] then p.kidsCur[#p.kidsCur+1]=n end
  end end
 for tid,ids in pairs(sobj.subs) do
  local pn=inst.byId[tid]
  if pn then
   local lst,seen={},{}
   for _,id in ipairs(ids) do local cn=inst.byId[id] if cn and cn~=pn and not seen[cn] then seen[cn]=true lst[#lst+1]=cn end end
   table.sort(lst,function(a,b) return a.z<b.z end)
   pn.kidsCur=lst end end
 -- sort kidsCur by z for all (keeps painter order)
 for _,n in ipairs(inst.nodes) do if #n.kidsCur>1 then table.sort(n.kidsCur,function(a,b) return a.z<b.z end) end end
 for _,n in ipairs(inst.nodes) do
  local id=n.L.id
  local sv=sobj.vals[id]
  for _,k in ipairs(n.dynl) do
   local tgt=(sv and sv[k]~=nil) and sv[k] or n.L.base[k]
   n.tg[k]=tgt
   if first or DISC[k] then n.cv[k]=tgt n.trk[k]=nil
   elseif abs(tgt-n.cv[k])>1e-6 or n.trk[k] then
    local spec=T and T.by[id] and T.by[id][k]
    if spec and spec.off then n.cv[k]=tgt n.trk[k]=nil
    else
     if not spec then spec={dur=TE.CFG.implicit,begin=0,spd=1,tf=TE.NAMED.default} end
     n.trk[k]={from=n.cv[k],to=tgt,t0=now+(spec.begin or 0),spec=spec} end end
  end
  -- image swap (discrete)
  local im=sobj.img[id]
  if im==nil then n.imgPath=n.L.img elseif im==false then n.imgPath=false else n.imgPath=n.L.dir.."/"..im end
  n.cellOv=sobj.cell[id]
  n.stAnims=sobj.anims[id]
 end end

TE.stateFor=function(inst,key,mode)
 local ca=inst.ca
 local ck=key.."|"..mode
 local r=ca.res[ck]
 if r==nil then local s,n=TE.pickState(ca,key,mode) r={s or false,n} ca.res[ck]=r end
 return r[1] or nil,r[2] or ("("..key..")") end

-- geometry + values for one instance at time `now`
TE.calc=function(inst,n,pn,now)
 local v=n.v
 for _,k in ipairs(n.dynl) do
  local tk=n.trk[k]
  if tk then local val,done=trackVal(tk,now) n.cv[k]=val if done then n.trk[k]=nil n.cv[k]=tk.to end end
  v[k]=n.cv[k] end
 if n.L.anims or n.stAnims then
  local function run(list,t)
   for _,A in ipairs(list) do
    local cur
    if A.fromBase or A.add then cur={} for i,k in ipairs(A.keys) do cur[i]=v[k] end end
    local out=TE.animEval(A,t,cur)
    if out then for i,k in ipairs(A.keys) do if out[i] then v[k]=out[i] end end end
   end end
  if n.L.anims then run(n.L.anims,n.clk) end
  if n.stAnims then run(n.stAnims,(now-inst.t0)*n.sc) end
 end
 if not pn then
  local f=inst.fit
  local rw,rh=v.w,v.h if rw<=0 then rw=inst.rw end if rh<=0 then rh=inst.rh end
  n.ma,n.mb,n.mc,n.md=f,0,0,f
  n.me,n.mf=inst.fw/2-f*rw/2,inst.fh/2-f*rh/2
  n.eop=v.op n.hid=v.hid>.5 n.sc=v.spd
 else
  local pv=pn.v local down=pn.L.flip
  local AX=v.x-pv.ox+v.tx
  local ayr=v.y-pv.oy
  local AY=down and (ayr+v.ty) or (pv.h-ayr-v.ty)
  local bx=v.ax*v.w local by=(down and v.ay or (1-v.ay))*v.h
  local th=(down and v.rot or -v.rot)*D2R
  local c,s=cos(th),sin(th)
  local sxx=v.sx*cos(v.ry*D2R) local syy=v.sy*cos(v.rx*D2R)
  local la,lb,lc,ld=c*sxx,s*sxx,-s*syy,c*syy
  local le,lf=AX-(la*bx+lc*by),AY-(lb*bx+ld*by)
  local pa,pb,pc,pd=pn.ma,pn.mb,pn.mc,pn.md
  n.ma=pa*la+pc*lb n.mb=pb*la+pd*lb n.mc=pa*lc+pc*ld n.md=pb*lc+pd*ld
  n.me=pa*le+pc*lf+pn.me n.mf=pb*le+pd*lf+pn.mf
  n.eop=pn.eop*v.op n.hid=pn.hid or v.hid>.5
  n.sc=pn.sc*v.spd
 end
 return v end

TE.walk=function(inst,n,pn,now,dt)
 TE.calc(inst,n,pn,now)
 n.clk=n.clk+dt*n.sc
 for _,k in ipairs(n.kidsCur) do TE.walk(inst,k,n,now,dt) end end

-- ---------- emitters ----------
local function pickCellImg(n,c)
 local ov=n.cellOv
 if ov and ov[c.name..".contents"]~=nil then local p=ov[c.name..".contents"] if p then return n.L.dir.."/"..p end return nil end
 return c.img end
local function cellProp(n,c,k,def)
 local ov=n.cellOv local v=ov and ov[c.name.."."..k]
 if v~=nil then return v end return def end
TE.spawn=function(inst,n,c,em,imgPath,w0,h0)
 local E=n.em local r=E.rnd
 local function rr(a) return (r()-.5)*2*a end
 local ex,ey=em.pos[1],em.pos[2]
 local sw,sh=em.size[1],em.size[2]
 local shp=em.shape local mode=em.mode
 if shp=="line" then
  if mode=="outline" or mode=="surface" or mode=="points" then ex=ex+((r()<.5) and -sw/2 or sw/2) else ex=ex+(r()-.5)*sw end
 elseif shp=="rectangle" or shp=="cuboid" then
  if mode=="points" then ex=ex+((r()<.5) and -sw/2 or sw/2) ey=ey+((r()<.5) and -sh/2 or sh/2)
  elseif mode=="outline" or mode=="surface" then
   if r()<.5 then ex=ex+(r()-.5)*sw ey=ey+((r()<.5) and -sh/2 or sh/2) else ey=ey+(r()-.5)*sh ex=ex+((r()<.5) and -sw/2 or sw/2) end
  else ex=ex+(r()-.5)*sw ey=ey+(r()-.5)*sh end
 elseif shp=="circle" or shp=="sphere" then
  local a=r()*6.2832 local rad=(sw/2)*((mode=="outline" or mode=="surface") and 1 or sqrt(r()))
  ex=ex+cos(a)*rad ey=ey+sin(a)*rad end
 local ang=c.lon+rr(c.rng)
 local sp=(c.vel+rr(c.velR))*em.mv
 local life=max(.05,(c.life+rr(c.lifeR))*em.ml)
 local col=c.col or {1,1,1}
 local p={cell=c,x=ex,y=ey,vx=cos(ang)*sp,vy=sin(ang)*sp,age=0,life=life,
  rot=(c.rot+rr(c.rotR)),spin=(c.spin+rr(c.spinR))*em.msp,al=max(0,min(1,(c.colA or 1)+rr(c.aR))),
  sc=max((c.sc+rr(c.scR))*em.msc,0),w=w0/c.cs,h=h0/c.cs,img=imgPath,
  cr=max(0,min(1,col[1]+rr(c.rR))),cg=max(0,min(1,col[2]+rr(c.gR))),cb=max(0,min(1,col[3]+rr(c.bR)))}
 E.pl[#E.pl+1]=p inst.live=inst.live+1 end
TE.emStep=function(inst,n,dt,now,warm)
 local em=n.L.em local E=n.em
 local visible=not (n.hid or n.eop<=.01)
 dt=dt*em.spd
 E.t=E.t+dt
 local dead={}
 for i=#E.pl,1,-1 do
  local p=E.pl[i] local c=p.cell
  p.age=p.age+dt
  if p.age>=p.life or not visible then
   p.dead=true table.remove(E.pl,i) inst.live=inst.live-1
  else
   p.vx=p.vx+c.ax*dt p.vy=p.vy+c.ay*dt p.x=p.x+p.vx*dt p.y=p.y+p.vy*dt
   p.rot=p.rot+p.spin*dt p.al=max(0,min(1,p.al+c.aS*dt)) p.sc=p.sc+c.scS*dt
   if c.rS~=0 then p.cr=max(0,min(1,p.cr+c.rS*dt)) end
   if c.gS~=0 then p.cg=max(0,min(1,p.cg+c.gS*dt)) end
   if c.bS~=0 then p.cb=max(0,min(1,p.cb+c.bS*dt)) end
  end end
 if not visible then return end
 local ov=n.cellOv
 local mr=em.mr local mvl=em.ml
 if ov then mr=ov["..birthRate"] or mr end
 local capAll=TE.CFG.maxParticles
 for ci,c in ipairs(em.cells) do
  local img=pickCellImg(n,c)
  local en=c.en
  local rate=cellProp(n,c,"birthRate",c.rate)
  local te=E.t-c.bt
  if img and en and rate>0 and te>=0 and te<=c.dur then
   E.acc[ci]=(E.acc[ci] or 0)+rate*mr*dt
   local w0,h0=TE.imgSize(img)
   if c.crect then w0=w0*c.crect[3] h0=h0*c.crect[4] end
   while E.acc[ci]>=1 do
    E.acc[ci]=E.acc[ci]-1
    local room=(inst.live<capAll*.8) or (E.rnd()<max(0,(capAll-inst.live)/(capAll*.2)))
    if room and #E.pl<TE.CFG.perEmitter then TE.spawn(inst,n,c,em,img,w0,h0) end
   end end
 end end

-- one full frame of an instance
TE.step=function(inst,dt,key,mode,now)
 inst.now=now
 local sobj,sname=TE.stateFor(inst,key,mode)
 if sname~=inst.stateName then TE.enter(inst,sobj,sname,now,inst.stateName==nil) end
 TE.walk(inst,inst.root,nil,now,dt)
 for _,n in ipairs(inst.ems) do TE.emStep(inst,n,dt,now) end end

-- pre-simulate emitters so effects look mature from the first frame (layer beginTime < 0)
TE.warm=function(inst,key,mode,now)
 local w=0
 for _,n in ipairs(inst.ems) do w=max(w,n.clk0) end
 w=min(w,TE.CFG.warmCap)
 local t=-w
 TE.step(inst,0,key,mode,now-w)
 while t<-.0001 do TE.step(inst,.1,key,mode,now+t) t=t+.1 end end
-- ---------- views (Roblox objects) ----------
local deg,atan2=math.deg,math.atan2
local D2R=math.pi/180
local function gravScale(g)
 if g=="resize" then return Enum.ScaleType.Stretch end
 if g=="resizeAspectFill" then return Enum.ScaleType.Crop end
 return Enum.ScaleType.Fit end
TE.makeView=function(par,insts)
 local holder=new("Frame",{Size=UDim2.fromScale(1,1),BackgroundTransparency=1,ClipsDescendants=true,ZIndex=1,BorderSizePixel=0},par)
 local view={holder=holder,vis={},frame=0}
 local zb=0
 for _,inst in ipairs(insts) do
  view.vis[#view.vis+1]={inst=inst,o={},clip={},mark={},pl={},seen={},pool={},dec={},zb=zb}
