local lastPos
local hooked={}
local function hook(ch)
local h=ch:WaitForChild("Humanoid",6)
if not h or hooked[h] then return end
hooked[h]=true
conn(h.StateChanged,function(_,new) if new==Enum.HumanoidStateType.Jumping then hs.jumps=hs.jumps+1 end end)
conn(h.Died,function() hs.deaths=hs.deaths+1 end) end
