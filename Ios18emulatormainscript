local function u16(s,be)
local o={} local i=1
if s:sub(1,2)=="\255\254" then be=false i=3 elseif s:sub(1,2)=="\254\255" then be=true i=3 end
while i+1<=#s do
local a,b=s:byte(i,i+1) local c=be and (a*256+b) or (b*256+a)
if c==0 then break end
if c>=0xD800 and c<0xDC00 and i+3<=#s then
local a2,b2=s:byte(i+2,i+3) local c2=be and (a2*256+b2) or (b2*256+a2)
c=0x10000+(c-0xD800)*1024+(c2-0xDC00) i=i+2 end
o[#o+1]=utf8.char(c) i=i+2 end
return table.concat(o) end
