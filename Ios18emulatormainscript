local function bridgeConnect()
if st.connected then return true end
if not (WebSocket and WebSocket.connect) then X.island("WebSocket not supported by this executor",2.2) return false end
local ok,ws=pcall(WebSocket.connect,"ws://"..bridgeAddr())
if not ok or not ws then X.island("Bridge not reachable",2) setStatus("Could not connect to "..bridgeAddr()) return false end
st.ws=ws st.connected=true
ws.OnMessage:Connect(function(m) pcall(onMsg,m) end)
ws.OnClose:Connect(function() st.connected=false st.ws=nil if modeBtn then modeBtn.Text="Reader" end if st.mode=="bridge" then setMode("reader") end end)
table.insert(app.cleanup,function() pcall(function() ws:Close() end) st.connected=false end)
return true end
-- ===== navigation =====
local function normalize(q)
q=q:gsub("^%s+",""):gsub("%s+$","")
if q=="" then return nil end
if q:match("^https?://") then return q end
if not q:find(" ") and q:find("%.") then return "https://"..q end
return "https://html.duckduckgo.com/html/?q="..HS:UrlEncode(q) end
local function isSearch(url) return url:find("html.duckduckgo.com/html/",1,true)~=nil end
local function load(url,push)
if st.mode=="bridge" then
if push~=false then st.url=url end
uf.text=url uf.refresh() send({cmd="goto",url=url}) return end
setStatus("Loading...") uf.text=url uf.refresh()
task.spawn(function()
local html,err=fetch(url)
local host=url:match("^https?://([^/]+)") or ""
st.url=url
if push~=false then
for i=#st.hist,st.hi+1,-1 do st.hist[i]=nil end
st.hist[#st.hist+1]=url st.hi=#st.hist end
if html and isSearch(url) then
local list=parseDDG(html,url)
if #list==0 then
local q=url:match("[?&]q=([^&]+)")
local bh=q and fetch("https://www.bing.com/search?q="..q)
if bh then list=parseBing(bh,"https://www.bing.com/") end end
if #list>0 then drawResults(list,"Results") setStatus(host) return end end
local chars=0
if html then chars=renderPage(html,url) setStatus(host) end
if chars<300 and not isSearch(url) then
setStatus("Loading with reader proxy...")
local md=fetch("https://r.jina.ai/"..url)
if md then local c2=renderMarkdown(md,url) if c2>chars then setStatus(host.." (reader proxy)") return end end
if not html then clearSF() addText(10,"Could not load this page.\n"..tostring(err or ""),16,F_R,P.sub) setStatus("Failed") return end
setStatus(host) end end) end
go=function(q) local u=normalize(q) if u then load(u) end end
local function back() if st.mode=="bridge" then send({cmd="back"}) return end
if st.hi>1 then st.hi=st.hi-1 load(st.hist[st.hi],false) else st.hi=0 showHome() uf.text="" uf.refresh() end end
local function fwd() if st.mode=="bridge" then send({cmd="forward"}) return end
if st.hi<#st.hist then st.hi=st.hi+1 load(st.hist[st.hi],false) end end
local function reload() if st.mode=="bridge" then send({cmd="reload"}) elseif st.url~="" then load(st.url,false) end end
uf=field(urlBar,0,0,W-32-60,44,"Search or enter website name",{col=P.text,pcol=P.sub,ret="go",
submit=function(t) X.kbClose() go(t) end,onFocus=function() end})
local rb=tbtn(urlBar,W-32-60,0,60,44,function() reload() end)
tx(rb,"Reload",0,0,60,44,12,BLUE,F_M)
-- bridge text input row
typeF=fr(cont,16,H-83-46,W-32,40,fieldBg,0,12) typeF.Visible=false typeF.ZIndex=3
local tf tf=field(typeF,0,0,W-32,40,"Type into page, then Return",{col=P.text,pcol=P.sub,ret="send",
submit=function(t) send({cmd="type",text=t}) tf.text="" tf.refresh() end})
-- bridge touch handling (tap = click, drag = scroll)
local sx,sy
bridgeImg.InputBegan:Connect(function(i)
if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then sx,sy=i.Position.X,i.Position.Y end end)
bridgeImg.InputEnded:Connect(function(i)
if not sx then return end
if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
local dx,dy=i.Position.X-sx,i.Position.Y-sy
local ap,as=bridgeImg.AbsolutePosition,bridgeImg.AbsoluteSize
if math.abs(dy)>12 then send({cmd="scroll",dy=-dy/as.Y})
else send({cmd="click",nx=(sx-ap.X)/as.X,ny=(sy-ap.Y)/as.Y}) end
sx=nil end end)
-- bottom bar
local navBar=fr(cont,0,H-83,W,83,P.card,0) fr(navBar,0,0,W,1,P.sep)
local function nb(i,label,cb) local x=(i-1)*(W/4)
local b=tbtn(navBar,x,0,W/4,56,cb) tx(b,label,0,0,W/4,56,15,BLUE,F_M) return b end
nb(1,"Back",back) nb(2,"Forward",fwd)
nb(3,"Home",function() if st.mode=="bridge" then send({cmd="goto",url="https://duckduckgo.com"}) else st.hi=0 st.hist={} showHome() uf.text="" uf.refresh() end end)
local mb=tbtn(navBar,3*(W/4),0,W/4,56,function()
snd("tap")
if st.mode=="bridge" then setMode("reader") modeBtn.Text="Reader" return end
if bridgeConnect() then setMode("bridge") modeBtn.Text="Bridge"
send({cmd="size",w=W,h=H-122-83}) if st.url~="" then send({cmd="goto",url=st.url}) end end end)
modeBtn=tx(mb,"Reader",0,0,W/4,56,15,BLUE,F_B)
table.insert(app.cleanup,function() pcall(function() if st.ws then st.ws:Close() end end) end)
if S.opt.safariQ then local q=S.opt.safariQ S.opt.safariQ=nil go(q) else showHome() end
end

