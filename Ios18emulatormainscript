local hu=ch and ch:FindFirstChildOfClass("Humanoid")
local speed=0
if hrp and hu and hu.Health>0 then
local pos=hrp.Position
if lastPos then
local dx,dz=pos.X-lastPos.X,pos.Z-lastPos.Z
local d=math.sqrt(dx*dx+dz*dz)
if d<25 then
hs.dist=hs.dist+d speed=d/.25
if speed>2 then hs.active=hs.active+.25 hs.stand["h"..os.date("%H")]=true end end end
lastPos=pos
else lastPos=nil end
local target=62+math.min(78,speed*2.4)
