local tacc,pacc=0,0
local function activePack() for _,p in ipairs(TE.packs) do if X.tweakOn("lw_"..p.id) then return p end end end
local function packBright(p)
 if p.bright~=nil then return p.bright end
 local r=p.cas[1] and p.cas[1].root
 local B=r and r.base
 p.bright=(B and B.bgA>.5 and (.299*B.bgR+.587*B.bgG+.114*B.bgB)>.8) and true or false
 return p.bright end
TE.rebuild=function()
 for _,c in pairs(TE.cur) do if c.holder then c.holder:Destroy() end end TE.cur={}
 local p=activePack() lastPack=p lastKey=nil X.aodAnim=(p~=nil)
 if p then
  if not p.insts then
   p.insts={}
   for _,ca in ipairs(p.cas) do p.insts[#p.insts+1]=TE.build(p,ca,W,H) end
   p.warmed=false end
  local par={lock=wallLock,home=wallHome,aod=X.aodHolder}
  for name,pr in pairs(par) do TE.cur[name]=TE.makeView(pr,p.insts) end
 end
 if X.aodRefresh then pcall(X.aodRefresh) end end
local oldApply=X.applyWalls
X.applyWalls=function() TE.cur={} oldApply() TE.rebuild() end
conn(RunService.Heartbeat,function(dt)
 pacc=pacc+dt
 if pacc>=.25 then pacc=0 if activePack()~=lastPack then TE.rebuild() end
  local lb=(lastPack~=nil) and (not S.dark) and packBright(lastPack) or false
  if lb~=(X.liveBright or false) then X.liveBright=lb pcall(X.applyTint) end end
 if not lastPack then return end
 tacc=tacc+dt
 if tacc<.033 then return end
 local step=math.min(tacc,.1) tacc=0
 local mode=S.dark and "Dark" or "Light"
 local key=S.off and "sleep" or ((S.screen=="lock") and "lock" or "home")
 local act={lock=lockL.Visible,home=(not S.off) and (not S.app),aod=S.off}
 if not (act.lock or act.home or act.aod) then return end
 local now=os.clock()
 if not lastPack.warmed then lastPack.warmed=true for _,inst in ipairs(lastPack.insts) do TE.warm(inst,key,mode,now) end end
 for _,inst in ipairs(lastPack.insts) do TE.step(inst,step,key,mode,now) end
 for name,view in pairs(TE.cur) do if act[name] then TE.paintView(view) end end
end)

