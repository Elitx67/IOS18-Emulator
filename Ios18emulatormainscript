local id=data:sub(p,p+idl-1) if id:byte(1)==0 then break end
local fs,hdr
if ver==2 then local a,b,c=data:byte(p+3,p+5) fs=a*65536+b*256+c hdr=6
else local a,b,c,d=data:byte(p+4,p+7)
if ver==4 then fs=(a%128)*2097152+(b%128)*16384+(c%128)*128+(d%128) else fs=a*16777216+b*65536+c*256+d end hdr=10 end
local body=data:sub(p+hdr,p+hdr+fs-1)
if id=="TIT2" or id=="TT2" then info.title=id3text(body)
elseif id=="TPE1" or id=="TP1" then info.artist=id3text(body)
elseif id=="TALB" or id=="TAL" then info.album=id3text(body)
elseif id=="APIC" or id=="PIC" then
local e=body:byte(1) local i=2
if id=="APIC" then local z=body:find("\0",i,true) i=(z or i)+1 else i=i+3 end
i=i+1
if e==1 or e==2 then
while i+1<=#body and not (body:byte(i)==0 and body:byte(i+1)==0) do i=i+2 end i=i+2
else local z=body:find("\0",i,true) i=(z or i)+1 end
local img=body:sub(i)
if #img>100 then info.cover=img info.ext=(img:sub(2,4)=="PNG") and "png" or "jpg" end end
p=p+hdr+fs end
return info end
