 local cyc=lt/A.dur
 if cyc>=A.tot then if not A.hold then return nil end cyc=A.tot end
 local ph
 if A.ar then local m=cyc%2 ph=(m<=1) and m or (2-m)
 else ph=cyc%1 if cyc>0 and ph==0 and cyc>=A.tot then ph=1 end end
 local vals=A.vals local n=#vals
 local out
 if A.spring and not A.kf then
  local p=A.spring(ph*A.dur) local v1=vals[1] or cur local v2=vals[2]
  out=lerpv(v1,v2,p)
 else
  if A.tf then ph=A.tf(ph) end
  local kt=A.kt
  if A.disc then
   local k=1 for i=1,n do if ph>=kt[i] then k=i end end out=vals[k]
  elseif n==1 then out=vals[1]
  else
   local calc=A.calc
   local times=kt
   if calc=="paced" or calc=="cubicPaced" then
    if not A.paced then
     local cum,tot={0},0
     for i=2,n do tot=tot+dist(vals[i-1],vals[i]) cum[i]=tot end
     local ts={} for i=1,n do ts[i]=(tot>0) and cum[i]/tot or (i-1)/(n-1) end
     A.paced=ts end
    times=A.paced end
   local k=n-1
   for i=1,n-1 do if ph<=times[i+1] then k=i break end end
   if ph<=times[1] then out=vals[1]
   else
    local f=(ph-times[k])/math.max(times[k+1]-times[k],1e-9)
    if f>1 then f=1 end
    if calc=="cubic" or calc=="cubicPaced" then out=catmull(vals[k-1] or vals[k],vals[k],vals[k+1],vals[k+2] or vals[k+1],f)
    else out=lerpv(vals[k],vals[k+1],f) end
   end
  end
