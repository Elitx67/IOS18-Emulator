 -- fit: aspect-fill the layer's own size onto the screen
 local rb=ca.root.base local dw,dh=rb.w,rb.h
 if dw<=0 or dh<=0 then dw,dh=pack.dw,pack.dh end
 inst.rw,inst.rh=dw,dh
 inst.fit=max(fitW/dw,fitH/dh)
 inst.fw,inst.fh=fitW,fitH
 inst.zmax=z
 return inst end

local function trackVal(tk,now)
 local el=(now-tk.t0)
 if el<0 then return tk.from,false end
 local s=tk.spec
 local p
 if s.spring then
  local tt=el*s.spd
  if tt>=s.dur then return tk.to,true end
  p=s.spring(tt)
 else
  local pp=el*s.spd/s.dur
  if pp>=1 then return tk.to,true end
  p=s.tf(pp) end
 return tk.from+(tk.to-tk.from)*p,false end

local DISC={hid=1}
TE.enter=function(inst,sobj,sname,now,first)
 local ca=inst.ca
 sobj=sobj or EMPTY
 local prevName=inst.stateName
 inst.stateObj=sobj inst.stateName=sname inst.t0=now
 local T=(not first) and TE.findTr(ca,prevName or "*",sname or "*") or nil
 -- sublayer membership
 local reparent,explicit={},{}
 for tid,ids in pairs(sobj.subs) do
  local pn=inst.byId[tid]
  if pn then explicit[tid]=true for _,id in ipairs(ids) do local cn=inst.byId[id] if cn and cn~=pn then reparent[cn]=pn end end end end
 for _,n in ipairs(inst.nodes) do n.kidsCur={} end
 for _,n in ipairs(inst.nodes) do
  local p=reparent[n] or n.parent
  if p then
   if reparent[n] or not explicit[p.L.id] then p.kidsCur[#p.kidsCur+1]=n end
  end end
 for tid,ids in pairs(sobj.subs) do
  local pn=inst.byId[tid]
  if pn then
   local lst,seen={},{}
   for _,id in ipairs(ids) do local cn=inst.byId[id] if cn and cn~=pn and not seen[cn] then seen[cn]=true lst[#lst+1]=cn end end
   table.sort(lst,function(a,b) return a.z<b.z end)
   pn.kidsCur=lst end end
 -- sort kidsCur by z for all (keeps painter order)
 for _,n in ipairs(inst.nodes) do if #n.kidsCur>1 then table.sort(n.kidsCur,function(a,b) return a.z<b.z end) end end
 for _,n in ipairs(inst.nodes) do
  local id=n.L.id
  local sv=sobj.vals[id]
  for _,k in ipairs(n.dynl) do
   local tgt=(sv and sv[k]~=nil) and sv[k] or n.L.base[k]
   n.tg[k]=tgt
   if first or DISC[k] then n.cv[k]=tgt n.trk[k]=nil
   elseif abs(tgt-n.cv[k])>1e-6 or n.trk[k] then
    local spec=T and T.by[id] and T.by[id][k]
    if spec and spec.off then n.cv[k]=tgt n.trk[k]=nil
    else
     if not spec then spec={dur=TE.CFG.implicit,begin=0,spd=1,tf=TE.NAMED.default} end
     n.trk[k]={from=n.cv[k],to=tgt,t0=now+(spec.begin or 0),spec=spec} end end
  end
  -- image swap (discrete)
  local im=sobj.img[id]
  if im==nil then n.imgPath=n.L.img elseif im==false then n.imgPath=false else n.imgPath=n.L.dir.."/"..im end
  n.cellOv=sobj.cell[id]
  n.stAnims=sobj.anims[id]
 end end

TE.stateFor=function(inst,key,mode)
 local ca=inst.ca
 local ck=key.."|"..mode
 local r=ca.res[ck]
 if r==nil then local s,n=TE.pickState(ca,key,mode) r={s or false,n} ca.res[ck]=r end
 return r[1] or nil,r[2] or ("("..key..")") end

-- geometry + values for one instance at time `now`
TE.calc=function(inst,n,pn,now)
 local v=n.v
 for _,k in ipairs(n.dynl) do
  local tk=n.trk[k]
  if tk then local val,done=trackVal(tk,now) n.cv[k]=val if done then n.trk[k]=nil n.cv[k]=tk.to end end
  v[k]=n.cv[k] end
 if n.L.anims or n.stAnims then
  local function run(list,t)
   for _,A in ipairs(list) do
    local cur
    if A.fromBase or A.add then cur={} for i,k in ipairs(A.keys) do cur[i]=v[k] end end
    local out=TE.animEval(A,t,cur)
    if out then for i,k in ipairs(A.keys) do if out[i] then v[k]=out[i] end end end
   end end
  if n.L.anims then run(n.L.anims,n.clk) end
  if n.stAnims then run(n.stAnims,(now-inst.t0)*n.sc) end
 end
 if not pn then
  local f=inst.fit
  local rw,rh=v.w,v.h if rw<=0 then rw=inst.rw end if rh<=0 then rh=inst.rh end
  n.ma,n.mb,n.mc,n.md=f,0,0,f
  n.me,n.mf=inst.fw/2-f*rw/2,inst.fh/2-f*rh/2
  n.eop=v.op n.hid=v.hid>.5 n.sc=v.spd
 else
  local pv=pn.v local down=pn.L.flip
  local AX=v.x-pv.ox+v.tx
  local ayr=v.y-pv.oy
  local AY=down and (ayr+v.ty) or (pv.h-ayr-v.ty)
  local bx=v.ax*v.w local by=(down and v.ay or (1-v.ay))*v.h
  local th=(down and v.rot or -v.rot)*D2R
  local c,s=cos(th),sin(th)
  local sxx=v.sx*cos(v.ry*D2R) local syy=v.sy*cos(v.rx*D2R)
  local la,lb,lc,ld=c*sxx,s*sxx,-s*syy,c*syy
  local le,lf=AX-(la*bx+lc*by),AY-(lb*bx+ld*by)
  local pa,pb,pc,pd=pn.ma,pn.mb,pn.mc,pn.md
  n.ma=pa*la+pc*lb n.mb=pb*la+pd*lb n.mc=pa*lc+pc*ld n.md=pb*lc+pd*ld
  n.me=pa*le+pc*lf+pn.me n.mf=pb*le+pd*lf+pn.mf
  n.eop=pn.eop*v.op n.hid=pn.hid or v.hid>.5
  n.sc=pn.sc*v.spd
 end
 return v end

TE.walk=function(inst,n,pn,now,dt)
 TE.calc(inst,n,pn,now)
 n.clk=n.clk+dt*n.sc
 for _,k in ipairs(n.kidsCur) do TE.walk(inst,k,n,now,dt) end end

-- ---------- emitters ----------
local function pickCellImg(n,c)
 local ov=n.cellOv
 if ov and ov[c.name..".contents"]~=nil then local p=ov[c.name..".contents"] if p then return n.L.dir.."/"..p end return nil end
 return c.img end
local function cellProp(n,c,k,def)
 local ov=n.cellOv local v=ov and ov[c.name.."."..k]
 if v~=nil then return v end return def end
TE.spawn=function(inst,n,c,em,imgPath,w0,h0)
 local E=n.em local r=E.rnd
 local function rr(a) return (r()-.5)*2*a end
 local ex,ey=em.pos[1],em.pos[2]
 local sw,sh=em.size[1],em.size[2]
 local shp=em.shape local mode=em.mode
 if shp=="line" then
  if mode=="outline" or mode=="surface" or mode=="points" then ex=ex+((r()<.5) and -sw/2 or sw/2) else ex=ex+(r()-.5)*sw end
 elseif shp=="rectangle" or shp=="cuboid" then
  if mode=="points" then ex=ex+((r()<.5) and -sw/2 or sw/2) ey=ey+((r()<.5) and -sh/2 or sh/2)
  elseif mode=="outline" or mode=="surface" then
   if r()<.5 then ex=ex+(r()-.5)*sw ey=ey+((r()<.5) and -sh/2 or sh/2) else ey=ey+(r()-.5)*sh ex=ex+((r()<.5) and -sw/2 or sw/2) end
  else ex=ex+(r()-.5)*sw ey=ey+(r()-.5)*sh end
 elseif shp=="circle" or shp=="sphere" then
  local a=r()*6.2832 local rad=(sw/2)*((mode=="outline" or mode=="surface") and 1 or sqrt(r()))
  ex=ex+cos(a)*rad ey=ey+sin(a)*rad end
 local ang=c.lon+rr(c.rng)
 local sp=(c.vel+rr(c.velR))*em.mv
 local life=max(.05,(c.life+rr(c.lifeR))*em.ml)
 local col=c.col or {1,1,1}
 local p={cell=c,x=ex,y=ey,vx=cos(ang)*sp,vy=sin(ang)*sp,age=0,life=life,
  rot=(c.rot+rr(c.rotR)),spin=(c.spin+rr(c.spinR))*em.msp,al=max(0,min(1,(c.colA or 1)+rr(c.aR))),
  sc=max((c.sc+rr(c.scR))*em.msc,0),w=w0/c.cs,h=h0/c.cs,img=imgPath,
  cr=max(0,min(1,col[1]+rr(c.rR))),cg=max(0,min(1,col[2]+rr(c.gR))),cb=max(0,min(1,col[3]+rr(c.bR)))}
 E.pl[#E.pl+1]=p inst.live=inst.live+1 end
TE.emStep=function(inst,n,dt,now,warm)
 local em=n.L.em local E=n.em
 local visible=not (n.hid or n.eop<=.01)
 dt=dt*em.spd
 E.t=E.t+dt
 local dead={}
 for i=#E.pl,1,-1 do
  local p=E.pl[i] local c=p.cell
  p.age=p.age+dt
  if p.age>=p.life or not visible then
   p.dead=true table.remove(E.pl,i) inst.live=inst.live-1
  else
   p.vx=p.vx+c.ax*dt p.vy=p.vy+c.ay*dt p.x=p.x+p.vx*dt p.y=p.y+p.vy*dt
   p.rot=p.rot+p.spin*dt p.al=max(0,min(1,p.al+c.aS*dt)) p.sc=p.sc+c.scS*dt
   if c.rS~=0 then p.cr=max(0,min(1,p.cr+c.rS*dt)) end
   if c.gS~=0 then p.cg=max(0,min(1,p.cg+c.gS*dt)) end
   if c.bS~=0 then p.cb=max(0,min(1,p.cb+c.bS*dt)) end
  end end
 if not visible then return end
 local ov=n.cellOv
 local mr=em.mr local mvl=em.ml
 if ov then mr=ov["..birthRate"] or mr end
 local capAll=TE.CFG.maxParticles
 for ci,c in ipairs(em.cells) do
  local img=pickCellImg(n,c)
  local en=c.en
  local rate=cellProp(n,c,"birthRate",c.rate)
  local te=E.t-c.bt
  if img and en and rate>0 and te>=0 and te<=c.dur then
   E.acc[ci]=(E.acc[ci] or 0)+rate*mr*dt
   local w0,h0=TE.imgSize(img)
   if c.crect then w0=w0*c.crect[3] h0=h0*c.crect[4] end
   while E.acc[ci]>=1 do
    E.acc[ci]=E.acc[ci]-1
    local room=(inst.live<capAll*.8) or (E.rnd()<max(0,(capAll-inst.live)/(capAll*.2)))
    if room and #E.pl<TE.CFG.perEmitter then TE.spawn(inst,n,c,em,img,w0,h0) end
   end end
 end end

-- one full frame of an instance
TE.step=function(inst,dt,key,mode,now)
 inst.now=now
 local sobj,sname=TE.stateFor(inst,key,mode)
 if sname~=inst.stateName then TE.enter(inst,sobj,sname,now,inst.stateName==nil) end
 TE.walk(inst,inst.root,nil,now,dt)
 for _,n in ipairs(inst.ems) do TE.emStep(inst,n,dt,now) end end

-- pre-simulate emitters so effects look mature from the first frame (layer beginTime < 0)
TE.warm=function(inst,key,mode,now)
 local w=0
 for _,n in ipairs(inst.ems) do w=max(w,n.clk0) end
 w=min(w,TE.CFG.warmCap)
 local t=-w
 TE.step(inst,0,key,mode,now-w)
 while t<-.0001 do TE.step(inst,.1,key,mode,now+t) t=t+.1 end end
-- ---------- views (Roblox objects) ----------
local deg,atan2=math.deg,math.atan2
local D2R=math.pi/180
local function gravScale(g)
 if g=="resize" then return Enum.ScaleType.Stretch end
 if g=="resizeAspectFill" then return Enum.ScaleType.Crop end
 return Enum.ScaleType.Fit end
TE.makeView=function(par,insts)
 local holder=new("Frame",{Size=UDim2.fromScale(1,1),BackgroundTransparency=1,ClipsDescendants=true,ZIndex=1,BorderSizePixel=0},par)
 local view={holder=holder,vis={},frame=0}
 local zb=0
 for _,inst in ipairs(insts) do
  view.vis[#view.vis+1]={inst=inst,o={},clip={},mark={},pl={},seen={},pool={},dec={},zb=zb}
  zb=zb+inst.zmax+2 end
 return view end

local function place(ctx,X,Y)
 if ctx.th==0 then return UDim2.fromOffset(X-ctx.x,Y-ctx.y) end
 local dx,dy=X-ctx.cx,Y-ctx.cy
 local c,s=math.cos(-ctx.th),math.sin(-ctx.th)
 return UDim2.fromOffset(dx*c-dy*s+ctx.w/2,dx*s+dy*c+ctx.h/2) end
local function setParent(o,p) if o.Parent~=p then o.Parent=p end end
local function ensureMain(vi,n,holder)
 local o=vi.o[n]
 if o~=nil then return o or nil end
 local L=n.L
 local z=vi.zb+n.z
 if L.text then
  o=new("TextLabel",{BackgroundTransparency=1,BorderSizePixel=0,AnchorPoint=Vector2.new(.5,.5),ZIndex=z,Visible=false,Text=L.text.s,
   TextColor3=Color3.new(L.text.col[1],L.text.col[2],L.text.col[3]),TextWrapped=L.text.wrap,TextYAlignment=Enum.TextYAlignment.Top,
   TextXAlignment=(L.text.al=="center") and XC or ((L.text.al=="right") and XR or XL),TextSize=14},holder)
  if FACE[F_M] then o.FontFace=FACE[F_M] end
 elseif L.img or n.needImg then
  o=new("ImageLabel",{BackgroundTransparency=1,BorderSizePixel=0,ScaleType=gravScale(L.grav),AnchorPoint=Vector2.new(.5,.5),ZIndex=z,Image="",Visible=false},holder)
  o:SetAttribute("img","")
 elseif n.hasBg or L.grad then
  o=new("Frame",{BorderSizePixel=0,AnchorPoint=Vector2.new(.5,.5),ZIndex=z,Visible=false,BackgroundColor3=Color3.new(1,1,1)},holder)
  if L.grad then
   local g=L.grad local cs,ts={},{}
   local nn=#g.cols
   for i,c in ipairs(g.cols) do
    local t=g.locs[i] or ((i-1)/(nn-1))
    if i>1 and t<=cs[#cs].Time then t=math.min(1,cs[#cs].Time+.0001) end
    cs[#cs+1]=ColorSequenceKeypoint.new(math.clamp(t,0,1),Color3.new(c[1],c[2],c[3]))
    ts[#ts+1]=NumberSequenceKeypoint.new(math.clamp(t,0,1),1-c[4]) end
   cs[1]=ColorSequenceKeypoint.new(0,cs[1].Value) ts[1]=NumberSequenceKeypoint.new(0,ts[1].Value)
   cs[#cs]=ColorSequenceKeypoint.new(1,cs[#cs].Value) ts[#ts]=NumberSequenceKeypoint.new(1,ts[#ts].Value)
   local sp,ep=g.sp,g.ep
   local dx,dy=(ep[1] or .5)-(sp[1] or .5),(ep[2] or 1)-(sp[2] or 0)
   local pdown=n.parent and n.parent.L.flip
   if not pdown then dy=-dy end
   new("UIGradient",{Color=ColorSequence.new(cs),Transparency=NumberSequence.new(ts),Rotation=deg(atan2(dy,dx))},o) end
 else o=false end
 vi.o[n]=o
 return o or nil end

local function ensureClip(vi,n,holder,rotated)
 local c=vi.clip[n]
 if c~=nil then return c or nil end
 if not n.L.mask then vi.clip[n]=false return nil end
 local cls=((n.L.base.cr>.5) or rotated) and "CanvasGroup" or "Frame"
 c=new(cls,{BackgroundTransparency=1,BorderSizePixel=0,ClipsDescendants=true,AnchorPoint=Vector2.new(.5,.5),ZIndex=vi.zb+n.z,Visible=false},holder)
 vi.clip[n]=c return c end

local function tintOf(v)
 local r,g,b=v.tnR,v.tnG,v.tnB
 if v.m1 then r=r*math.clamp(v.m1,0,1) g=g*math.clamp(v.m7,0,1) b=b*math.clamp(v.m13,0,1) end
 return Color3.new(math.clamp(r,0,1),math.clamp(g,0,1),math.clamp(b,0,1)) end

TE.paintNode=function(view,vi,n,ctx,holder,fr)
 local L,v=n.L,n.v
 vi.mark[n]=fr
 local vis=(not n.hid) and n.eop>.003
 local cw,ch=v.w,v.h
 local a,b,c,d,e,f=n.ma,n.mb,n.mc,n.md,n.me,n.mf
 local sx=math.sqrt(a*a+b*b)
 local sy=(sx>1e-9) and (a*d-b*c)/sx or 0
 local rot=(sx>1e-9) and deg(atan2(b,a)) or 0
 local cxs,cys=a*cw/2+c*ch/2+e,b*cw/2+d*ch/2+f
 local nctx=ctx
 if vis and L.mask then
  local rotated=math.abs(rot)>.05
  local cf=ensureClip(vi,n,holder,rotated)
  if cf and sx>1e-6 and sy>1e-6 and cw>0 and ch>0 and (not rotated or cf:IsA("CanvasGroup")) then
   setParent(cf,ctx.frame)
   cf.Position=place(ctx,cxs,cys) cf.Size=UDim2.fromOffset(cw*sx,ch*sy) cf.Rotation=rot-(ctx.rd or 0) cf.Visible=true
   if cf:IsA("CanvasGroup") then
    local dc=vi.dec[cf] if not dc then dc={c=new("UICorner",{},cf)} vi.dec[cf]=dc end dc.c.CornerRadius=UDim.new(0,v.cr*sx) end
   nctx={frame=cf,th=rot*D2R,rd=rot,cx=cxs,cy=cys,w=cw*sx,h=ch*sy,x=cxs-cw*sx/2,y=cys-ch*sy/2}
  elseif cf then cf.Visible=false end end
 local o=ensureMain(vi,n,holder)
 if o then
  if vis and cw>0 and ch>0 then
   setParent(o,ctx.frame)
   o.Visible=true
   o.Position=place(ctx,cxs,cys)
   o.Size=UDim2.fromOffset(cw*sx,ch*sy)
   o.Rotation=rot-(ctx.rd or 0)
   if L.text then
    o.TextSize=math.clamp(math.floor(L.text.size*math.max(sx,.01)+.5),1,100)
    o.TextTransparency=1-n.eop
   else
    local isImg=o:IsA("ImageLabel")
    if isImg then
     local path=n.imgPath
     if (path or "")~=o:GetAttribute("img") then
      o:SetAttribute("img",path or "")
      o.Image=(path and TE.asset(path)) or ""
      if path and L.crect then
       local iw,ih=TE.imgSize(path)
       o.ImageRectOffset=Vector2.new(L.crect[1]*iw,L.crect[2]*ih) o.ImageRectSize=Vector2.new(L.crect[3]*iw,L.crect[4]*ih) end
     end
     local ta=(v.tnA or 1)
     if v.m19 then ta=ta*math.clamp(v.m19,0,1) end
     o.ImageTransparency=1-math.clamp(n.eop*ta,0,1)
     o.ImageColor3=tintOf(v)
     if L.grav=="center" and n.imgPath then
      local iw,ih=TE.imgSize(n.imgPath) o.ScaleType=Enum.ScaleType.Stretch
      o.Size=UDim2.fromOffset(iw/L.cs*sx,ih/L.cs*sy) end
    end
    if n.hasBg then
     o.BackgroundColor3=Color3.new(math.clamp(v.bgR,0,1),math.clamp(v.bgG,0,1),math.clamp(v.bgB,0,1))
     o.BackgroundTransparency=1-math.clamp(n.eop*v.bgA,0,1) end
    if L.grad then o.BackgroundTransparency=1-n.eop end
   end
   local r=v.cr*sx
   local dec=vi.dec[o]
   if r>.5 or (v.bw>0 and v.bcA>.003) or dec then
    if not dec then dec={} vi.dec[o]=dec end
    if r>.5 then if not dec.c then dec.c=new("UICorner",{},o) end dec.c.CornerRadius=UDim.new(0,r) elseif dec.c then dec.c:Destroy() dec.c=nil end
    if v.bw>0 and v.bcA>.003 then
     if not dec.s then dec.s=new("UIStroke",{},o) end
     dec.s.Thickness=v.bw*sx dec.s.Color=Color3.new(v.bcR,v.bcG,v.bcB) dec.s.Transparency=1-math.clamp(v.bcA*n.eop,0,1)
    elseif dec.s then dec.s:Destroy() dec.s=nil end
   end
  else o.Visible=false end
 end
 -- particles
 if n.em then
  local E=n.em
  for _,p in ipairs(E.pl) do
   local lab=vi.pl[p]
   if not lab then
    lab=table.remove(vi.pool) or new("ImageLabel",{BackgroundTransparency=1,BorderSizePixel=0,AnchorPoint=Vector2.new(.5,.5),ScaleType=Enum.ScaleType.Stretch},holder)
    vi.pl[p]=lab
    lab.Image=TE.asset(p.img) or ""
    local cr=p.cell.crect
    if cr then local iw,ih=TE.imgSize(p.img) lab.ImageRectOffset=Vector2.new(cr[1]*iw,cr[2]*ih) lab.ImageRectSize=Vector2.new(cr[3]*iw,cr[4]*ih)
    else lab.ImageRectOffset=Vector2.new(0,0) lab.ImageRectSize=Vector2.new(0,0) end
   end
   vi.seen[p]=fr
   local own=L.flip
   local lx=p.x-v.ox
   local ly=own and (p.y-v.oy) or (v.h-(p.y-v.oy))
   local s=math.max(p.sc,0)
   if s<=.0005 or not vis then lab.Visible=false
   else
    setParent(lab,ctx.frame)
    lab.Visible=true lab.ZIndex=vi.zb+n.z
    lab.Position=place(ctx,a*lx+c*ly+e,b*lx+d*ly+f)
    lab.Size=UDim2.fromOffset(p.w*s*sx,p.h*s*math.abs(sy))
    lab.Rotation=rot-(ctx.rd or 0)+((own and p.rot or -p.rot)*57.29578)
    lab.ImageTransparency=1-math.clamp(p.al*n.eop,0,1)
    lab.ImageColor3=Color3.new(p.cr,p.cg,p.cb)
   end
  end
 end
 for _,k in ipairs(n.kidsCur) do TE.paintNode(view,vi,k,nctx,holder,fr) end end

TE.paintView=function(view)
 view.frame=view.frame+1 local fr=view.frame
 for _,vi in ipairs(view.vis) do
  TE.paintNode(view,vi,vi.inst.root,{frame=view.holder,x=0,y=0,th=0,rd=0},view.holder,fr)
  for n,o in pairs(vi.o) do if o and vi.mark[n]~=fr then o.Visible=false end end
  for n,c in pairs(vi.clip) do if c and vi.mark[n]~=fr then c.Visible=false end end
  for p,lab in pairs(vi.pl) do
   if p.dead or vi.seen[p]~=fr then lab.Visible=false vi.pl[p]=nil vi.pool[#vi.pool+1]=lab end end
 end end
-- ---------- pack discovery ----------
local function rank(n) n=n:lower()
 if n:find("background") then return 1 elseif n:find("floating") then return 2 elseif n:find("foreground") then return 3 end return 2 end
local function isCA(p)
 if p:lower():match("%.ca$") then return true end
 local ok,r=pcall(isfile,p.."/main.caml") return ok and r and true or false end
local function walk(dir,depth,out)
 if depth>40 then return end
 local ok,list=pcall(listfiles,dir) if not ok then return end
 for _,p in ipairs(list) do
  if p:find("__MACOSX",1,true) then
  elseif isfolder(p) then
   if isCA(p) then out[#out+1]=p else walk(p,depth+1,out) end
