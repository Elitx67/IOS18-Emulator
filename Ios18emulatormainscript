new("UIStroke",{Color=P.sep,Thickness=1},dstBox)
local result=tx(dstBox,"Translation appears here",16,16,W-64,148,19,P.sub,F_R,XL)
result.TextWrapped=true result.TextYAlignment=Enum.TextYAlignment.Top
local last=""
local seq=0
local HS=game:GetService("HttpService")
local function doTr()
seq=seq+1 local my=seq
local t=inp2 and inp2.text or ""
if t=="" then result.Text="Translation appears here" result.TextColor3=P.sub last="" return end
if srcL==dstL then result.Text=t result.TextColor3=P.text last=t return end
result.Text="Translating..." result.TextColor3=P.sub
task.delay(.5,function()
if my~=seq or not cont.Parent then return end
task.spawn(function()
local url="https://api.mymemory.translated.net/get?q="..HS:UrlEncode(t).."&langpair="..codes[srcL].."|"..codes[dstL]
local ok,body=pcall(function() return game:HttpGet(url) end)
if not ok then
local rq=request or http_request or (syn and syn.request)
if rq then local ok2,r=pcall(rq,{Url=url,Method="GET"}) if ok2 and r and r.Body then ok,body=true,r.Body end end end
if my~=seq or not cont.Parent then return end
if ok and body then
local ok2,d=pcall(function() return HS:JSONDecode(body) end)
local out=ok2 and type(d)=="table" and d.responseData and d.responseData.translatedText
if out then
out=out:gsub("&quot;","\""):gsub("&#39;","'"):gsub("&amp;","&")
result.Text=out result.TextColor3=P.text last=out return end end
result.Text="Could not translate. Your executor needs HTTP access." result.TextColor3=P.sub end) end) end
