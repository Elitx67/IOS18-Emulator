     rR=num(ca.redRange,0),gR=num(ca.greenRange,0),bR=num(ca.blueRange,0),rS=num(ca.redSpeed,0),gS=num(ca.greenSpeed,0),bS=num(ca.blueSpeed,0),
     bt=num(ca.beginTime,0),dur=num(ca.duration,math.huge),subs={}}
    if math.abs(cell.bt)>1e5 then cell.bt=0 end
    if cell.cs<=0 then cell.cs=1 end
    local cr2=nums(ca.contentsRect) if #cr2>=4 and not (cr2[3]==1 and cr2[4]==1 and cr2[1]==0 and cr2[2]==0) then cell.crect=cr2 end
    local csrc=TE.imgSrc(cc) if csrc then cell.img=dir.."/"..FP.rel(csrc) end
    local col=ca.color and TE.col(ca.color) if not col then local ck=kid(c,"color") if ck then col=TE.col(ck.a.value,ck.a.opacity) end end
    if col then cell.col={col[1],col[2],col[3]} cell.colA=col[4] end
    into[#into+1]=cell
