local function paginate(text,fs)
local per=math.floor(((W-40)/(fs*.52))*((H-250)/(fs*1.35)))
local pages,cur={},""
for para in (text:gsub("\r","").."\n"):gmatch("(.-)\n") do
local piece=para.."\n"
while #piece>per do
local cut=piece:sub(1,per):match("^.*()%s") or per
if #cur+cut>per and #cur>0 then pages[#pages+1]=cur cur="" end
cur=cur..piece:sub(1,cut) piece=piece:sub(cut+1)
if #cur>=per then pages[#pages+1]=cur cur="" end end
if #cur+#piece>per and #cur>0 then pages[#pages+1]=cur cur="" end
cur=cur..piece end
