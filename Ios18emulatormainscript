local PRP={Frame={"BackgroundColor3"},CanvasGroup={"BackgroundColor3"},ScrollingFrame={"BackgroundColor3"},
TextLabel={"BackgroundColor3","TextColor3"},TextButton={"BackgroundColor3","TextColor3"},TextBox={"BackgroundColor3","TextColor3"},
