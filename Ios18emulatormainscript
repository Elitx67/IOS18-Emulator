b64dec=function(d)
local f=(crypt and crypt.base64decode) or (crypt and crypt.base64 and crypt.base64.decode) or base64_decode or (base64 and base64.decode)
if f then return f(d) end
local b="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
d=d:gsub("[^"..b.."=]","")
return (d:gsub(".",function(x) if x=="=" then return "" end local r,v="",(b:find(x,1,true)-1) for i=6,1,-1 do r=r..(v%2^i-v%2^(i-1)>0 and "1" or "0") end return r end)
:gsub("%d%d%d?%d?%d?%d?%d?%d?",function(x) if #x~=8 then return "" end local c=0 for i=1,8 do c=c+(x:sub(i,i)=="1" and 2^(8-i) or 0) end return string.char(c) end)) end
local function bridgeAddr()
if isfile and isfile("IOS18/bridge.txt") then local ok,t=pcall(readfile,"IOS18/bridge.txt") if ok and t then t=t:gsub("%s","") if #t>0 then return t end end end
return "127.0.0.1:8765" end
